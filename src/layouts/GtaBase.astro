---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { site } from '../data/site';
import { defaultLocale, getDictionary, getLocale, locales } from '../i18n';
import { getGtaDictionary } from '../i18n/gta';
import '../styles/gta.css';

// Layout of the GTA release variant. Same <head> as Base.astro, but single-theme.
const locale = getLocale(Astro.currentLocale);
const t = getGtaDictionary(locale);
const canonical = getAbsoluteLocaleUrl(locale);
const ogImage = new URL('og.png', canonical);
const alternates = locales.map((code) => ({ hreflang: code, href: getAbsoluteLocaleUrl(code) }));
// og.png is the regular site's preview image, drawn from the main dictionary (src/lib/brand.ts).
const ogImageAlt = `${getDictionary(locale).hero.title.join(' ')} — ${site.name}, ${site.domain}`;
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="author" content={site.name} />
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale)} />

    <meta name="theme-color" content="#1b1033" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.domain} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:locale" content={t.ogLocale} />
    {
      locales
        .filter((code) => code !== locale)
        .map((code) => <meta property="og:locale:alternate" content={getGtaDictionary(code).ogLocale} />)
    }
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload only what the loading screen shows. -->
    <Font cssVariable="--font-gta-display" preload={[{ weight: 900, subset: 'latin' }]} />
    <Font cssVariable="--font-gta-script" preload={[{ weight: 400, subset: 'latin' }]} />
    <Font cssVariable="--font-display" preload={[{ weight: 700, subset: 'latin' }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, subset: 'latin' }]} />
  </head>
  <body>
    <slot />
  </body>
</html>
