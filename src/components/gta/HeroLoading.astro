---
import { site } from '../../data/site';
import { getGtaDictionary } from '../../i18n/gta';

// Hero as a loading screen: release countdown, artwork collage, loading tips.
const { help, hero } = getGtaDictionary(Astro.currentLocale);
const [claimA, claimB] = hero.claim;
---

<section class="hero" id="top" aria-label={hero.label}>
  <div class="wrap">
    <div
      class="help"
      data-help
      data-remaining={help.remaining}
      data-remaining-time={help.remainingTime}
      data-day={help.day}
      data-days={help.days}
      data-today-headline={help.todayHeadline}
      data-today={help.today}
      hidden
    >
      <p><strong>{help.headline}</strong> <span data-countdown></span></p>
      <button type="button" data-help-close aria-label={help.close}>×</button>
    </div>
    <script is:inline>
      // Release countdown. Inline and right after the box, so showing it never shifts the hero below.
      // Both dates are the visitor's local midnight: Thursday is Thursday wherever they are.
      (() => {
        const help = document.querySelector('[data-help]');
        const headline = help.querySelector('strong');
        const countdown = help.querySelector('[data-countdown]');
        const text = help.dataset;
        const release = new Date(2026, 10, 19).getTime();
        const dayAfter = new Date(2026, 10, 20).getTime();
        const pad = (n) => String(n).padStart(2, '0');
        let timer = 0;
        // Updates the box, then checks again: every second until the release, every minute on the day, never after it.
        function tick() {
          const now = Date.now();
          if (now >= dayAfter) {
            help.hidden = true;
            return;
          }
          help.hidden = false;
          if (now >= release) {
            headline.textContent = text.todayHeadline;
            countdown.textContent = text.today;
            timer = setTimeout(tick, 60000);
            return;
          }
          let s = Math.floor((release - now) / 1000);
          const d = Math.floor(s / 86400);
          s -= d * 86400;
          const h = Math.floor(s / 3600);
          s -= h * 3600;
          const m = Math.floor(s / 60);
          s -= m * 60;
          const time = pad(h) + ':' + pad(m) + ':' + pad(s);
          const days = d === 1 ? text.day : text.days.replace('{n}', String(d));
          countdown.textContent = d ? text.remaining.replace('{days}', days).replace('{time}', time) : text.remainingTime.replace('{time}', time);
          timer = setTimeout(tick, 1000 - (now % 1000));
        }
        let dismissed = false;
        try {
          dismissed = sessionStorage.getItem('help-closed') === '1';
        } catch (e) {}
        if (!dismissed) tick();
        help.querySelector('[data-help-close]').addEventListener('click', () => {
          clearTimeout(timer);
          help.hidden = true;
          try {
            sessionStorage.setItem('help-closed', '1');
          } catch (e) {}
          // The button went with the box; continue from the hero heading instead of <body>.
          document.querySelector('[data-hero-title]').focus();
        });
      })();
    </script>

    <div class="collage">
      <div class="panel panel-main">
        <svg viewBox="0 0 1200 800" preserveAspectRatio="xMaxYMax slice" aria-hidden="true" focusable="false">
