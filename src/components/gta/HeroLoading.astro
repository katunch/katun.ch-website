<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Loading tips: rotate every 7 s while the bar is on screen, until the visitor takes over or hovers/focuses the bar.
     The rotation stays silent for screen readers; only tips the visitor asks for are announced. */
  const bar = document.querySelector<HTMLElement>('[data-loadbar]');
  const tipBox = document.querySelector<HTMLElement>('[data-tip-box]');
  const tipEl = document.querySelector<HTMLElement>('[data-tip]');
  const tips: string[] = JSON.parse(tipEl?.dataset.tips ?? '[]');
  if (bar && tipBox && tipEl && tips.length) {
    let tipI = 0;
    let tipAuto = !reduce;
    let tipPause = false;
    let tipOnScreen = true;
    const nextTip = () => {
      tipI = (tipI + 1) % tips.length;
      tipEl.textContent = tips[tipI];
    };
    bar.addEventListener('mouseenter', () => (tipPause = true));
    bar.addEventListener('mouseleave', () => (tipPause = false));
    bar.addEventListener('focusin', () => (tipPause = true));
    bar.addEventListener('focusout', () => (tipPause = false));
    new IntersectionObserver((entries) => {
      tipOnScreen = entries[0]?.isIntersecting ?? true;
    }).observe(bar);
    document.querySelector('[data-tip-next]')?.addEventListener('click', () => {
      tipAuto = false;
      tipBox.setAttribute('aria-live', 'polite');
      nextTip();
    });
    setInterval(() => {
      if (tipAuto && tipOnScreen && !tipPause && !document.hidden) nextTip();
    }, 7000);
  }

  /* "Loading" finishes after a moment. */
  const loading = document.querySelector('[data-loading]');
  const loadingText = document.querySelector<HTMLElement>('[data-loading-text]');
  setTimeout(
    () => {
      loading?.classList.add('is-done');
      if (loadingText) loadingText.textContent = loadingText.dataset.done ?? '';
    },
    reduce ? 0 : 2400,
  );
</script>

<style>
  .hero { position: relative; padding: 86px 0 28px; }
  .help {
    position: absolute; top: 18px; left: var(--gutter); z-index: 5;
    max-width: min(560px, 60vw);
    padding: 11px 44px 11px 16px;
    background: rgba(10, 6, 20, .86);
    font: 500 1rem/1.4 var(--body);
  }
  .help p { margin: 0; }
  .help strong { color: var(--sun); font-weight: 600; }
  .help [data-countdown] { font-variant-numeric: tabular-nums; }
  .help button {
    position: absolute; top: 6px; right: 6px; width: 30px; height: 30px;
    border: 0; background: none; color: var(--chalk); font-size: 1.4rem; line-height: 1; cursor: pointer;
  }

  .collage {
    display: grid; gap: 22px;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    grid-template-rows: 1fr 1fr;
  }
  .panel {
    position: relative; overflow: hidden;
    border: 4px solid var(--chalk);
    box-shadow: 10px 10px 0 rgba(0, 0, 0, .5);
    transform: rotate(var(--r, 0deg));
    animation: slam .7s cubic-bezier(.2, 1.4, .4, 1) both;
    animation-delay: var(--d, 0s);
  }
  @keyframes slam {
    from { opacity: 0; transform: translateY(40px) rotate(calc(var(--r, 0deg) * 4)) scale(.94); }
    to { opacity: 1; transform: rotate(var(--r, 0deg)); }
  }
  .panel > svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .panel-main { grid-row: 1 / span 2; min-height: clamp(580px, 76vh, 780px); --r: -.5deg; }
  .panel-servers { --r: 1.2deg; --d: .12s; }
  .panel-term { --r: -1.4deg; --d: .24s; }

  .hero-copy {
    position: relative; z-index: 2;
    padding: clamp(28px, 5vw, 60px);
    max-width: 760px;
  }
  .hero h1 {
    margin: 0;
    font: 900 clamp(3.4rem, 9.6vw, 8.4rem)/.84 var(--display);
    letter-spacing: .005em;
    color: var(--chalk);
    text-shadow: 4px 0 var(--ink), -4px 0 var(--ink), 0 4px var(--ink), 0 -4px var(--ink),
                 3px 3px var(--ink), -3px -3px var(--ink), 3px -3px var(--ink), -3px 3px var(--ink),
                 8px 10px 0 var(--flamingo);
  }
  .claim { margin: .5em 0 .55em; }
  .claim-a {
    display: block;
    font: 700 clamp(1.9rem, 4.4vw, 3.3rem)/1 var(--cond);
    letter-spacing: .01em;
    text-shadow: var(--outline);
  }
  .claim-b {
    display: block; width: max-content;
    margin-top: -.02em; padding-right: .3em;
    /* The floor gives way below ~390px, so "Viel Drehmoment." still fits inside the panel on a 360px phone. */
    font: 400 clamp(min(2.9rem, 11.8vw), 6.8vw, 5.4rem)/1.05 var(--script);
