---
import { Image } from 'astro:assets';
import ride from '../../assets/gta-ride.webp';
import { getGtaDictionary } from '../../i18n/gta';

// "Unterwegs": the painted ride photo, the bike's stat card and the lessons.
const { ride: t } = getGtaDictionary(Astro.currentLocale);
const [torque, latency] = t.stats.bars;
---

<section class="section" id="ride">
  <div class="wrap">
    <header class="sec-head">
      <h2 class="title">{t.title}</h2>
      <p class="lede">{t.lede}</p>
    </header>
    <div class="ride">
      <figure class="ride-photo">
        <Image
          src={ride}
          alt={t.photo.alt}
          widths={[360, 440, 720, 880]}
          sizes="(min-width: 1021px) 432px, (min-width: 761px) 352px, (min-width: 480px) 432px, 100vw"
        />
        <figcaption class="zone"><span class="zone-name">{t.photo.zone}</span>{' '}<span class="zone-meta">{t.photo.altitude}</span></figcaption>
      </figure>
      <div class="ride-side">
        <div class="stats">
          <p class="stats-maker">{t.stats.maker}</p>
          <h3>{t.stats.model}</h3>
          <div class="statbar statbar--full"><span>{torque}</span><i></i></div>
          <div class="statbar statbar--low"><span>{latency}</span><i></i></div>
          <dl class="specs">
            {
              t.stats.specs.map(({ term, value }) => (
                <>
                  <dt>{term}</dt>
                  <dd>{value}</dd>
                </>
              ))
            }
          </dl>
        </div>

        <h3 class="lessons-title">{t.lessonsTitle}</h3>
        <div class="lessons">
          {
            t.lessons.map(({ title, body }) => (
              <article class="lesson">
                <h4>{title}</h4>
                <p>{body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ride { display: grid; grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .ride-photo {
    position: relative; margin: 0;
    border: 4px solid var(--chalk);
    box-shadow: 12px 12px 0 var(--flamingo);
    transform: rotate(-1.4deg);
    background: var(--plum);
  }
  .ride-photo :global(img) { width: 100%; height: auto; }
  .zone {
    position: absolute; right: 16px; bottom: 14px; text-align: right;
    display: flex; flex-direction: column; align-items: flex-end;
  }
  .zone-name {
    font: 400 clamp(2.4rem, 5vw, 3.2rem)/1 var(--script); color: var(--chalk);
    text-shadow: 3px 3px 0 var(--ink), 0 0 14px rgba(22, 12, 41, .8);
  }
  .zone-meta { font: 700 1.05rem/1.2 var(--cond); color: var(--sun); text-shadow: 2px 2px 0 var(--ink); }
  .ride-side .lessons-title { margin-top: clamp(40px, 5vw, 56px); }
  .stats { padding: 30px 28px; background: rgba(10, 6, 20, .9); border: 4px solid var(--chalk); box-shadow: 10px 10px 0 rgba(0, 0, 0, .5); }
  .stats-maker { margin: 0; font: 700 1.1rem var(--cond); color: var(--sun); }
  .stats h3 { margin: 0 0 .7em; font: 900 clamp(2rem, 3.6vw, 2.7rem)/.95 var(--display); }
  .statbar { margin-bottom: 14px; }
  .statbar--full { --v: 100%; }
  .statbar--low { --v: 10%; }
  .statbar span { display: block; font: 600 1.05rem/1.4 var(--cond); margin-bottom: 4px; }
  .statbar i {
    display: block; height: 12px;
    background: linear-gradient(90deg, var(--chalk) var(--v), rgba(255, 243, 228, .2) var(--v));
    -webkit-mask: repeating-linear-gradient(90deg, #000 0 calc(10% - 3px), transparent calc(10% - 3px) 10%);
            mask: repeating-linear-gradient(90deg, #000 0 calc(10% - 3px), transparent calc(10% - 3px) 10%);
  }
  .specs { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 6px 18px; margin: 22px 0 0; padding-top: 18px; border-top: 1px solid rgba(255, 243, 228, .2); }
  .specs dt { font: 600 1.05rem/1.5 var(--cond); color: var(--muted); }
  .specs dd { margin: 0; line-height: 1.5; font-weight: 600; }

  .lessons-title { margin: clamp(56px, 8vw, 80px) 0 24px; font: 900 clamp(1.9rem, 4vw, 2.6rem)/1 var(--display); text-shadow: var(--outline), 4px 5px 0 var(--flamingo); }
  .lessons { display: grid; gap: 18px; }
  .lesson { padding: 20px 22px 22px; background: rgba(10, 6, 20, .82); border-top: 4px solid var(--sun); }
  .lesson h4 { margin: 0 0 .4em; font: 700 1.4rem/1.15 var(--cond); color: var(--sun); }
  .lesson p { margin: 0; color: var(--muted); }

  @media (max-width: 1020px) {
    .ride { grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 36px; }
  }
  @media (max-width: 760px) {
    .ride { grid-template-columns: 1fr; }
    .ride-photo { width: min(100%, 440px); margin-inline: auto; transform: rotate(-1deg); }
  }
</style>
