---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLocale, locales } from '../../i18n';
import { getGtaDictionary } from '../../i18n/gta';

// Sticky pause-menu header: SK badge, tabs with the language switch at the right end, and the HUD (cash + wanted level).
// Up to 900px (56.25em) the tabs no longer fit next to the inline cash: the same <nav> becomes an overlay behind a burger.
const locale = getLocale(Astro.currentLocale);
const { ui, nav, hud } = getGtaDictionary(locale);
const languages = locales
  .filter((code) => code !== locale)
  .map((code) => {
    const { lang, language } = getGtaDictionary(code);
    return { code, lang, name: language.name, href: getRelativeLocaleUrl(code) };
  });
const star = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.5 1.3 6.6L12 17.2l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z';
---

<header class="pause" data-pause>
  <a class="sk" href="#top" aria-label={ui.home}>SK</a>
  <nav class="menu" id="pause-menu" aria-label={ui.mainNav} data-menu>
    <p class="menu-title" aria-hidden="true">{ui.menu}</p>
    <ul class="tabs">
      {
        nav.sections.map(({ href, label }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))
      }
      <li><a href={nav.contact.href}>{nav.contact.label}</a></li>
      {
        languages.map(({ code, lang, name, href }) => (
          <li class="lang">
            <a href={href} lang={lang} hreflang={code}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3z" />
              </svg>
              {name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="hud">
    <a class="hud-cash" href="#print" data-cash data-cheat={hud.cheatCash} aria-label={hud.cashLabel}>{hud.cash}</a>
    <div class="hud-stars" data-stars data-calm={hud.wanted.calm} data-hot={hud.wanted.hot} role="img" aria-label={hud.wanted.calm}>
      {
        Array.from({ length: 5 }, () => (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={star} />
          </svg>
        ))
      }
    </div>
  </div>
  <button
    type="button"
    class="burger"
    aria-expanded="false"
    aria-controls="pause-menu"
    aria-label={ui.menuOpen}
    data-burger
    data-label-open={ui.menuOpen}
    data-label-close={ui.menuClose}
  >
    <span aria-hidden="true"></span>
  </button>
</header>

<script>
  /* Highlight the tab of the section in the middle of the viewport (in the bar and in the overlay). */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tabs a[href^="#"]')];
  const byId = new Map(links.map((a) => [a.getAttribute('href')?.slice(1), a]));
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((a) => {
          a.classList.remove('is-active');
          a.removeAttribute('aria-current');
        });
        const a = byId.get(entry.target.id);
        if (a) {
          a.classList.add('is-active');
          a.setAttribute('aria-current', 'true');
        }
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((s) => io.observe(s));

  /* Burger menu below the breakpoint: the nav turns into a modal overlay.
     Everything else on the page is inert while it's open, Tab wraps between the links and the burger.
     The burger is focused with preventScroll: it's always on screen, but Chrome scrolls the page
     to "reveal" the sticky button otherwise. */
  const pause = document.querySelector<HTMLElement>('[data-pause]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  // Same query as the @media rules in the <style> below.
  const narrow = matchMedia('(max-width: 56.25em)');
  if (pause && menu && burger) {
    let inerted: HTMLElement[] = [];
    const isOpen = () => burger.getAttribute('aria-expanded') === 'true';
    const items = () => [...menu.querySelectorAll<HTMLElement>('a[href]'), burger];

    const setOpen = (open: boolean) => {
      if (open === isOpen()) return;
      pause.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('pause-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', (open ? burger.dataset.labelClose : burger.dataset.labelOpen) ?? '');
      if (open) {
        const keep = [pause, menu, burger];
        inerted = [...document.body.children, ...pause.children].filter(
          (el): el is HTMLElement => el instanceof HTMLElement && !(el instanceof HTMLScriptElement) && !keep.includes(el) && !el.inert,
        );
        inerted.forEach((el) => (el.inert = true));
      } else {
        inerted.forEach((el) => (el.inert = false));
        inerted = [];
      }
    };

    burger.addEventListener('click', () => {
      if (isOpen()) {
        setOpen(false);
        return;
      }
      setOpen(true);
      items()[0]?.focus({ preventScroll: true });
    });
    // Section links close the menu and the browser scrolls on; the language link closes it for the back button.
    menu.addEventListener('click', (e) => {
      if (isOpen() && e.target instanceof Element && e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        burger.focus({ preventScroll: true });
        return;
      }
      if (e.key !== 'Tab') return;
      // Every Tab is handled here, so focus never leaves the menu and reaching the burger never scrolls the page.
      e.preventDefault();
      const list = items();
      const i = list.indexOf(document.activeElement as HTMLElement);
      const next = list[(i + (e.shiftKey ? -1 : 1) + list.length) % list.length];
      // Links scroll into view inside the overlay (short landscape screens); the burger is always on screen.
      next.focus(next === burger ? { preventScroll: true } : undefined);
    });
    // Wide enough for the bar again: the tabs are back in it, so close the overlay.
    narrow.addEventListener('change', () => {
      if (!narrow.matches) setOpen(false);
    });
  }
</script>

<style>
  .pause {
    --pause-h: 62px;
    position: sticky; top: 0; z-index: 50;
    display: flex; align-items: center; gap: 12px;
    min-height: var(--pause-h);
    padding: 10px var(--gutter);
  }
  /* The blur sits on a pseudo-element: on the header itself it would make the header
     the containing block of the fixed menu overlay. */
  .pause::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(22, 12, 41, .94), rgba(22, 12, 41, .8));
    /* The -webkit- fallback for Safari 17 and older sits in @supports at the end: in the same
       rule the minifier keeps only the last of the pair. */
    backdrop-filter: blur(8px);
  }
  .pause::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; height: 3px;
    background: linear-gradient(90deg, var(--flamingo), var(--tangerine) 50%, var(--sun));
  }
  .sk {
    flex: none; display: grid; place-items: center;
    width: 42px; height: 42px;
    background: linear-gradient(135deg, var(--flamingo), var(--tangerine));
    border: 3px solid var(--chalk);
    color: var(--ink); text-decoration: none;
    font: 900 1.45rem/1 var(--display); letter-spacing: .02em;
  }

  /* ---------- Bar: tabs on the left, language switch at the right end ---------- */
  .menu { flex: 1; min-width: 0; }
  .menu-title { display: none; }
  .tabs {
    list-style: none; margin: 0; padding: 0;
    display: flex; align-items: center; gap: 4px;
  }
  .tabs a {
    display: block; white-space: nowrap;
    padding: 7px 14px;
    font: 600 1.08rem/1.2 var(--cond); letter-spacing: .02em;
    text-decoration: none; color: var(--chalk);
    background: rgba(255, 243, 228, .07);
    transition: background-color .15s, color .15s;
  }
  .tabs a:hover, .tabs a.is-active { background: var(--chalk); color: var(--ink); }
  /* Inset focus ring; on a chalk tab an ink line under it keeps the yellow ring from blending in. */
  .tabs a:focus-visible { outline-offset: -3px; }
  .tabs a:is(:hover, .is-active):focus-visible { box-shadow: inset 0 0 0 5px var(--ink); }

  .lang { margin-left: auto; padding-left: 24px; }
  .lang a {
    display: flex; align-items: center; gap: 7px;
    padding: 5px 12px;
    background: transparent;
    border: 2px solid rgba(255, 243, 228, .5);
  }
  .lang a:hover { border-color: var(--chalk); }
  .lang svg { flex: none; width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2; }
  /* Outside the border: an inset ring would only recolour it. */
  .lang a:focus-visible { outline-offset: 3px; }

  /* ---------- HUD: under the bar on the right ---------- */
  .hud {
    position: absolute; right: var(--gutter); top: calc(100% + 14px);
    display: flex; flex-direction: column; align-items: flex-end; gap: 6px;
    pointer-events: none;
  }
  .hud-cash {
    pointer-events: auto;
    font: 900 2.3rem/1 var(--display); letter-spacing: .02em;
    color: var(--cash); text-decoration: none;
    text-shadow: var(--outline), 4px 5px 0 var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .hud-stars { display: flex; gap: 3px; }
  .hud-stars svg { width: 24px; height: 24px; }
  .hud-stars path { fill: rgba(22, 12, 41, .55); stroke: var(--chalk); stroke-width: 2.2; stroke-linejoin: round; }
  .hud-stars.is-wanted path { fill: var(--sun); stroke: var(--ink); animation: wanted .5s steps(2, jump-none) infinite; }
  @keyframes wanted { 50% { fill: var(--chalk); } }

  .burger { display: none; }

  /* ---------- Up to 900px: SK, cash, burger; the nav is a full-screen pause menu ----------
     In em, so a larger default font size switches earlier instead of overflowing the bar.
     At the default 16px it is the 900px where HeroLoading and Overlays expect the cash inline.
     Keep it in sync with `narrow` in the script. */
  @media (max-width: 56.25em) {
    .sk, .hud, .burger { position: relative; z-index: 2; }

    .hud { inset: auto; flex-direction: row; align-items: center; margin-left: auto; }
    .hud-cash { font-size: 1.5rem; text-shadow: 2px 0 var(--ink), -2px 0 var(--ink), 0 2px var(--ink), 0 -2px var(--ink), 2px 3px 0 var(--ink); }
    .hud-stars { display: none; }

    .burger {
      flex: none; display: grid; place-items: center;
      width: 42px; height: 42px; padding: 0;
      background: rgba(22, 12, 41, .55); color: var(--chalk);
      border: 3px solid var(--chalk);
      cursor: pointer;
      transition: background-color .15s, color .15s;
    }
    .burger[aria-expanded='true'] { background: var(--chalk); color: var(--ink); }
    .burger span, .burger span::before, .burger span::after {
      display: block; width: 22px; height: 3px; background: currentColor;
      transition: transform .18s, background-color .18s;
    }
    .burger span { position: relative; }
    .burger span::before, .burger span::after { content: ""; position: absolute; left: 0; }
    .burger span::before { top: -7px; }
    .burger span::after { top: 7px; }
    .burger[aria-expanded='true'] span { background-color: transparent; }
    .burger[aria-expanded='true'] span::before { transform: translateY(7px) rotate(45deg); }
    .burger[aria-expanded='true'] span::after { transform: translateY(-7px) rotate(-45deg); }

    /* Starts under the bar, so nothing scrolls beneath SK, cash and burger on short screens. */
    .menu {
      position: fixed; inset: var(--pause-h) 0 0; z-index: 1;
      display: flex; flex-direction: column;
      padding: 26px var(--gutter) 28px;
      overflow-y: auto; overscroll-behavior: contain;
      background:
        radial-gradient(110% 55% at 100% 0%, rgba(255, 79, 154, .2), transparent 60%),
        linear-gradient(180deg, rgba(58, 26, 92, .95), rgba(22, 12, 41, .97) 55%);
      backdrop-filter: blur(12px);
      /* While it fades out, clicks and the wheel already go to the page. */
      visibility: hidden; opacity: 0; pointer-events: none;
      transition: opacity .16s ease-out, visibility 0s linear .16s;
    }
    .is-open .menu { visibility: visible; opacity: 1; pointer-events: auto; transition: opacity .16s ease-out; }

    .menu-title {
      display: block; margin: 0 0 22px;
      font: 900 clamp(3rem, 13vw, 4.4rem)/.9 var(--display); letter-spacing: .01em;
      color: var(--chalk);
      text-shadow: var(--outline), 5px 6px 0 var(--flamingo);
    }
    .tabs {
      flex: 1 0 auto;
      flex-direction: column; align-items: stretch; gap: 6px;
      transform: translateY(-10px);
      transition: transform .2s cubic-bezier(.2, .9, .3, 1.2);
    }
    .is-open .tabs { transform: none; }
    .tabs a {
      padding: 9px 18px;
      font: 700 clamp(1.7rem, 7.4vw, 2.1rem)/1.1 var(--cond); letter-spacing: .02em;
    }
    .tabs a.is-active { box-shadow: 6px 6px 0 var(--flamingo); }
    .tabs a.is-active:focus-visible { box-shadow: inset 0 0 0 5px var(--ink), 6px 6px 0 var(--flamingo); }

    /* Language switch at the bottom, under its own gradient bar. */
    .lang { position: relative; margin: auto 0 0; padding: 30px 0 0; }
    .lang::before {
      content: ""; position: absolute; left: 0; right: 0; top: 10px; height: 4px;
      background: linear-gradient(90deg, var(--flamingo), var(--tangerine) 50%, var(--sun));
    }
    .lang a {
      gap: 10px; width: max-content;
      padding: 8px 18px;
      font-size: 1.35rem;
      background: rgba(22, 12, 41, .55);
      border: 3px solid var(--chalk);
      box-shadow: 5px 5px 0 rgba(0, 0, 0, .5);
    }
    .lang svg { width: 22px; height: 22px; }

    :global(html.pause-open) { overflow: hidden; scrollbar-gutter: stable; }
  }
  /* Not on touch screens, where :hover sticks after the tap that closed the menu. */
  @media (max-width: 56.25em) and (hover: hover) {
    .burger:hover { background: var(--chalk); color: var(--ink); }
  }
  @supports not (backdrop-filter: blur(1px)) {
    .pause::before { -webkit-backdrop-filter: blur(8px); }
    @media (max-width: 56.25em) {
      .menu { -webkit-backdrop-filter: blur(12px); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu, .is-open .menu, .tabs, .burger span, .burger span::before, .burger span::after { transition: none; }
  }
</style>
