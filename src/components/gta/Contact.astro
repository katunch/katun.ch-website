---
import { site } from '../../data/site';
import { getGtaDictionary } from '../../i18n/gta';

// "Kontakt": the in-game phone with three contacts.
const { contact } = getGtaDictionary(Astro.currentLocale);
const contacts = [
  { initial: 'Z', name: 'Zenify', detail: new URL(site.links.zenify).host, href: site.links.zenify },
  { initial: 'L', name: 'LinkedIn', detail: site.name, href: site.links.linkedin, rel: 'me' },
  { initial: 'G', name: 'GitHub', detail: new URL(site.links.github).pathname.slice(1), href: site.links.github, rel: 'me' },
];
---

<section class="section" id="contact">
  <div class="wrap contact">
    <div>
      <h2 class="title">{contact.title}</h2>
      <p class="lede">{contact.lede}</p>
    </div>
    <div class="phone">
      <div class="phone-screen">
        <div class="phone-bar">
          <span data-clock>12:00</span>
          <svg viewBox="0 0 46 12" aria-hidden="true">
            <rect x="0" y="8" width="3" height="4"></rect><rect x="5" y="5" width="3" height="7"></rect><rect x="10" y="2" width="3" height="10"></rect><rect x="15" y="0" width="3" height="12"></rect>
            <rect x="24" y="1" width="18" height="10" rx="2" fill="none" stroke="#fff3e4" stroke-width="1.5"></rect><rect x="26" y="3" width="13" height="6"></rect><rect x="43" y="4" width="2" height="4"></rect>
          </svg>
        </div>
        <p class="phone-app" aria-hidden="true">{contact.app}</p>
        <ul class="contacts">
          {
            contacts.map(({ initial, name, detail, href, rel }) => (
              <li>
                <a href={href} rel={rel}>
                  <span class="avatar" aria-hidden="true">{initial}</span>
                  <span>
                    <strong>{name}</strong>{' '}
                    <small>{detail}</small>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="phone-foot">{contact.hint}</p>
      </div>
    </div>
  </div>
</section>

<script>
  /* Phone clock: local time, refreshed every 15 s. */
  const clock = document.querySelector('[data-clock]');
  if (clock) {
    const pad = (n: number) => String(n).padStart(2, '0');
    const setClock = () => {
      const d = new Date();
      clock.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes());
    };
    setClock();
    setInterval(setClock, 15000);
  }
</script>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 56px; align-items: center; }
  .contact .lede { color: var(--chalk); }
  .phone {
    width: 310px; padding: 14px 14px 22px;
    background: var(--ink);
    border: 4px solid var(--chalk); border-radius: 38px;
    box-shadow: 12px 12px 0 var(--flamingo);
    transform: rotate(3deg);
  }
  .phone-screen {
    border-radius: 26px; overflow: hidden; min-height: 400px;
    background: linear-gradient(170deg, #ff9142 -10%, #ff4f9a 30%, #3a1a5c 70%, #1b1033);
    padding: 10px 14px 18px;
  }
  .phone-bar { display: flex; justify-content: space-between; align-items: center; padding: 2px 8px 14px; font: 700 .95rem var(--cond); }
  .phone-bar svg { width: 46px; height: 12px; fill: var(--chalk); }
  .phone-app { margin: 4px 6px 14px; font: 900 2rem/1 var(--display); text-shadow: 2px 3px 0 var(--ink); }
  .contacts { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .contacts a {
    display: flex; align-items: center; gap: 12px; padding: 10px 12px;
    background: rgba(10, 6, 20, .72); text-decoration: none;
    transition: background-color .15s, color .15s;
  }
  .contacts a:hover { background: var(--chalk); color: var(--ink); }
  .avatar {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    font: 900 1.3rem/1 var(--display); color: var(--ink); border: 3px solid var(--ink);
  }
  .contacts li:nth-child(1) .avatar { background: var(--sun); }
  .contacts li:nth-child(2) .avatar { background: var(--lagoon); }
  .contacts li:nth-child(3) .avatar { background: var(--tangerine); }
  .contacts strong { display: block; font: 700 1.15rem/1.15 var(--cond); }
  .contacts small { display: block; font-size: .92rem; opacity: .8; }
  .phone-foot { margin: 16px 6px 0; font: 600 .98rem/1.35 var(--cond); color: var(--chalk); opacity: .85; }

  @media (max-width: 900px) {
    .contact { grid-template-columns: 1fr; }
    .phone { margin-inline: auto; transform: rotate(2deg); }
  }
</style>
