---
// Decorative tachometer, needle resting in the low range.
const majorTicks = [-135, -90, -45, 0, 45, 90, 135];
const minorTicks = [-112.5, -67.5, -22.5, 22.5, 67.5, 112.5];
---

<svg class="gauge" viewBox="0 0 320 290" aria-hidden="true" focusable="false">
  <circle class="gauge__arc gauge__arc--track" cx="160" cy="160" r="130" stroke-dasharray="612.6 816.8" transform="rotate(135 160 160)"></circle>
  <circle class="gauge__arc gauge__arc--redline" cx="160" cy="160" r="130" stroke-dasharray="102.1 816.8"></circle>
  <g class="gauge__ticks gauge__ticks--major">
    {majorTicks.map((angle) => <line x1="160" y1="44" x2="160" y2="64" transform={`rotate(${angle} 160 160)`} />)}
  </g>
  <g class="gauge__ticks gauge__ticks--minor">
    {minorTicks.map((angle) => <line x1="160" y1="44" x2="160" y2="55" transform={`rotate(${angle} 160 160)`} />)}
  </g>
  <g class="gauge__numbers">
    {
      majorTicks.map((angle, value) => (
        <text
          class:list={[{ 'gauge__number--redline': value === majorTicks.length - 1 }]}
          x="160"
          y="92"
          transform={`rotate(${angle} 160 160) rotate(${-angle} 160 86)`}
        >
          {value}
        </text>
      ))
    }
  </g>
  <line class="gauge__needle" x1="160" y1="176" x2="160" y2="60" transform="rotate(-18 160 160)"></line>
  <circle class="gauge__hub" cx="160" cy="160" r="9"></circle>
  <text class="gauge__unit" x="160" y="222">RPM ×1000</text>
  <text class="gauge__mode" x="160" y="254">MODE · RIDE</text>
</svg>

<style>
  .gauge {
    flex: 0 1 260px;
    width: 100%;
    max-width: 260px;
    height: auto;
  }

  .gauge__arc {
    fill: none;
    stroke-width: 10;
  }

  .gauge__arc--track {
    stroke: var(--gauge-track);
  }

  .gauge__arc--redline {
    stroke: var(--accent);
  }

  .gauge__ticks {
    stroke-linecap: round;
  }

  .gauge__ticks--major {
    stroke: var(--text-muted);
    stroke-width: 2.5;
  }

  .gauge__ticks--minor {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .gauge__numbers {
    fill: var(--text-body);
    font-family: var(--font-mono);
    font-size: 16px;
    text-anchor: middle;
  }

  .gauge__number--redline {
    fill: var(--accent);
  }

  .gauge__needle {
    stroke: var(--accent);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .gauge__hub {
    fill: var(--band-surface);
    stroke: var(--text);
    stroke-width: 2;
  }

  .gauge__unit {
    fill: var(--band-dim);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 1px;
    text-anchor: middle;
  }

  .gauge__mode {
    fill: var(--accent);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    letter-spacing: 2px;
    text-anchor: middle;
  }
</style>
