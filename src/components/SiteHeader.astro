---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getDictionary, getLocale } from '../i18n';
import Button from './Button.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import Monogram from './Monogram.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** On pages other than the one-pager (404), links lead to its sections instead of in-page anchors. */
  linkToHome?: boolean;
}

const { linkToHome = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const { nav, ui } = getDictionary(locale);
const home = linkToHome ? getRelativeLocaleUrl(locale) : '';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={home || '#top'} class="brand">
      <Monogram />
      <span class="brand__domain">katun.ch</span>
      <span class="sr-only"> — Silas Knobel, {linkToHome ? ui.home : ui.backToTop}</span>
    </a>
    <nav class="site-nav" aria-label={ui.mainNav}>
      <ul>
        {nav.map(({ href, label }) => (
          <li>
            <a href={home + href}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__actions">
      <LanguageSwitch />
      <ThemeToggle />
      <Button href={`${home}#contact`} variant="ink" size="sm" dot>{ui.contact}</Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
  }

  .brand__domain {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 26px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .site-nav a {
    display: block;
    padding: 12px 0;
    color: var(--text-muted);
  }

  .site-nav a:hover {
    color: var(--text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Narrow screens: brand + actions on top, nav on its own row. */
  @media (max-width: 52rem) {
    .site-header__inner {
      gap: 4px 16px;
    }

    .site-nav ul {
      justify-content: space-between;
      column-gap: 12px;
    }

    .site-nav {
      order: 1;
      flex-basis: 100%;
    }
  }

  /* Phones: the monogram alone carries the brand, leaving room for the actions.
     The domain stays in the link's accessible name. A slightly smaller nav keeps
     all six links on one row down to 360px. */
  @media (max-width: 27rem) {
    .site-nav ul {
      column-gap: 8px;
      font-size: 13px;
    }

    .brand__domain {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
